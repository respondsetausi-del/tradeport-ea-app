<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep red under-glow (behind card, large blur feel) -->
    <item
        android:left="-8dp"
        android:top="-8dp"
        android:right="-8dp"
        android:bottom="-8dp">
        <shape android:shape="rectangle">
            <solid android:color="#20990000" />
            <corners android:radius="36dp" />
        </shape>
    </item>
    <!-- Secondary glow layer -->
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#15880000" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Card surface - solid dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#30990000" />
        </shape>
    </item>
</layer-list>
