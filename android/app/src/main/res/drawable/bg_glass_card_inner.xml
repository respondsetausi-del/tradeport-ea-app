<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Card Inner Background - Darker variant for nested panels -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Base: 8% white (slightly darker for inner cards) -->
    <solid android:color="#14FFFFFF" />
    
    <!-- Corners: 16dp radius (slightly smaller than outer) -->
    <corners android:radius="16dp" />
    
    <!-- Border: 1dp stroke with 7% white -->
    <stroke
        android:width="1dp"
        android:color="#12FFFFFF" />
    
</shape>
