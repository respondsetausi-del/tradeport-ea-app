<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow effect -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10990000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Transparent inner with subtle border -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0d0d0d" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#22990000" />
        </shape>
    </item>
</layer-list>
