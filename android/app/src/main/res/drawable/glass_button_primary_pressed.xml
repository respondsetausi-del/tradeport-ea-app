<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intense outer glow when pressed -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40cc0000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glass button surface - brighter -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFaa0000"
                android:endColor="#FF880000"
                android:angle="135" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="#80ff4444" />
        </shape>
    </item>
</layer-list>
