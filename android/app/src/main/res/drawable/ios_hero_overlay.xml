<?xml version="1.0" encoding="utf-8"?>
<!-- Hero image overlay - desaturates and darkens, embeds into glass -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Soft darkening gradient from bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#40000000"
                android:endColor="#CC000000" />
        </shape>
    </item>
    
    <!-- Very subtle red ambient from bottom - connects to trading panel -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:centerX="0.5"
                android:centerY="1.2"
                android:startColor="#15660000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
</layer-list>
