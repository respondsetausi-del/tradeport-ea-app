<?xml version="1.0" encoding="utf-8"?>
<!-- Glass orb style for floating button - matches trading panel rounded style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer soft red glow/halo - large diffused -->
    <item
        android:bottom="-8dp"
        android:left="-8dp"
        android:right="-8dp"
        android:top="-8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%p"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#30cc0000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
    <!-- Inner subtle red rim glow -->
    <item
        android:bottom="-4dp"
        android:left="-4dp"
        android:right="-4dp"
        android:top="-4dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#40990000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
    <!-- Main glass surface - dark with slight transparency -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6181818" />
            <stroke
                android:width="1dp"
                android:color="#25ffffff" />
        </shape>
    </item>
    
</layer-list>
