<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Stronger red underglow on press -->
    <item
        android:left="-5dp"
        android:top="-5dp"
        android:right="-5dp"
        android:bottom="-5dp">
        <shape android:shape="oval">
            <solid android:color="#25990000" />
        </shape>
    </item>
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="oval">
            <solid android:color="#18cc0000" />
        </shape>
    </item>
    <!-- Button surface - slightly brighter on press -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#aa0000" />
        </shape>
    </item>
</layer-list>
