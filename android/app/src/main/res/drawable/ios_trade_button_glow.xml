<?xml version="1.0" encoding="utf-8"?>
<!-- Trade button with crimson circular edge glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer crimson glow ring -->
    <item
        android:left="-3dp"
        android:top="-3dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#30880000" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Inner glow -->
    <item
        android:left="-1dp"
        android:top="-1dp"
        android:right="-1dp"
        android:bottom="-1dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#25990000" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Button surface -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%p"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#40990000"
                android:endColor="#20660000" />
            <stroke
                android:width="0.5dp"
                android:color="#20ffffff" />
        </shape>
    </item>
    
</layer-list>
