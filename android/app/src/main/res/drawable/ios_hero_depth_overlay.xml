<?xml version="1.0" encoding="utf-8"?>
<!-- Hero image overlay - darkened, slightly transparent, depth layer -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Darkening gradient from bottom -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#50000000"
                android:endColor="#B0000000" />
        </shape>
    </item>
    
    <!-- Ambient crimson glow from bottom - under-layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.5"
                android:centerY="1.3"
                android:startColor="#20660000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
    <!-- Overall slight desaturation/darken -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15000000" />
        </shape>
    </item>
    
</layer-list>
