<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Liquid Glass style button - translucent with soft edges -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer soft glow -->
    <item
        android:left="-3dp"
        android:top="-3dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#18990000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Main glass surface - translucent red -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3990000" />
            <corners android:radius="24dp" />
            <stroke
                android:width="0.5dp"
                android:color="#40ffffff" />
        </shape>
    </item>
    
</layer-list>
