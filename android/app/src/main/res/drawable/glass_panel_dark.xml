<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08ffffff" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <!-- Glass surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CC0a0a0a"
                android:endColor="#CC141414"
                android:angle="135" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#20ffffff" />
        </shape>
    </item>
</layer-list>
