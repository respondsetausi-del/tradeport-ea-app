<?xml version="1.0" encoding="utf-8"?>
<!-- Glass background for expanded floating overlay window -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Dark base for opacity -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8101010" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Glass overlay with top highlight gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#08FFFFFF"
                android:centerY="0.3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Border stroke -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
</layer-list>
