<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 3D Depth Card - soft vertical lighting, minimal shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Soft crimson edge glow - sits just outside -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="100%p"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#18660000"
                android:endColor="#00000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    
    <!-- Minimal depth shadow underneath -->
    <item
        android:top="2dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#30000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Card surface with vertical lighting gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#24222222"
                android:centerColor="#E6181818"
                android:endColor="#E6141414" />
            <corners android:radius="28dp" />
            <stroke
                android:width="0.5dp"
                android:color="#15ffffff" />
        </shape>
    </item>
    
</layer-list>
