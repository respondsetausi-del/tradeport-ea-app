<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle red underglow behind card -->
    <item
        android:left="-3dp"
        android:top="-3dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <solid android:color="#08990000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glass card surface - dark and solid -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#12990000" />
        </shape>
    </item>
</layer-list>
