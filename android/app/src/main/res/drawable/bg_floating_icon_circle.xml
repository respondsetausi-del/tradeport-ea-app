<?xml version="1.0" encoding="utf-8"?>
<!-- Clean dark circle for floating icon with subtle glow border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow ring -->
    <item
        android:left="-2dp"
        android:top="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="30dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#4000D4FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Dark circle base -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#E6111111" />
        </shape>
    </item>

    <!-- Top glass highlight -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Border stroke -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="#3000D4FF" />
        </shape>
    </item>

</layer-list>
