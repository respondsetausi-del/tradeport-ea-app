<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Depth Background - atmospheric gradient, not colorful -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Deep black top → dark crimson bottom, very smooth -->
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#000000"
        android:centerColor="#0A0505"
        android:endColor="#150808" />
    
</shape>
