<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Trade Button Ring - Neutral base for theme tinting -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Glass button base - dark neutral -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#E6181818" />
        </shape>
    </item>
    
    <!-- Internal 3D lighting on button -->
    <item
        android:top="5dp"
        android:left="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    
</layer-list>
