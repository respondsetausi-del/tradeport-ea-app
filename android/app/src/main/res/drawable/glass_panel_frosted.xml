<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0Cffffff" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Frosted glass layer -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6080808"
                android:centerColor="#E60d0d0d"
                android:endColor="#E6101010"
                android:angle="145" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="#25ffffff" />
        </shape>
    </item>
</layer-list>
