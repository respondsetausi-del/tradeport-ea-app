<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intense outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#50cc0000" />
        </shape>
    </item>
    <!-- Mid glow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#70990000" />
        </shape>
    </item>
    <!-- Inner glass button - brighter -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#FFcc0000"
                android:endColor="#FFaa0000"
                android:angle="135" />
            <stroke
                android:width="2dp"
                android:color="#80ff6666" />
        </shape>
    </item>
</layer-list>
