<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Liquid Glass Panel - For larger control areas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base frosted glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#35FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Soft inner gradient for frosted effect -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#28FFFFFF"
                android:endColor="#15FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    
    <!-- Hairline border -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#20FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
</layer-list>
