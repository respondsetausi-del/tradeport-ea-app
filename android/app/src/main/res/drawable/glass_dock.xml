<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0Affffff" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <!-- Glass dock surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D9101010"
                android:endColor="#D91a1a1a"
                android:angle="90" />
            <corners android:radius="38dp" />
            <stroke
                android:width="1dp"
                android:color="#30ffffff" />
        </shape>
    </item>
</layer-list>
