<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Rotating Ring - Asymmetric glow for visible rotation effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Asymmetric crimson sweep - creates visible rotation -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#60BB0000"
                android:centerColor="#00000000"
                android:endColor="#30990000" />
            <stroke
                android:width="3dp"
                android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Inner ring edge - richer crimson -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#40AA0000" />
        </shape>
    </item>
    
</layer-list>
