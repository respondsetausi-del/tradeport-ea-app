<?xml version="1.0" encoding="utf-8"?>
<!-- iOS Control Panel with 3D depth - soft lighting -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Thin crimson edge glow -->
    <item
        android:left="-1dp"
        android:top="-1dp"
        android:right="-1dp"
        android:bottom="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#20660000" />
            <solid android:color="#00000000" />
            <corners android:radius="33dp" />
        </shape>
    </item>
    
    <!-- Minimal depth shadow -->
    <item
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#25000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    
    <!-- Panel surface with subtle vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#D9252525"
                android:centerColor="#D9202020"
                android:endColor="#D91A1A1A" />
            <corners android:radius="32dp" />
            <stroke
                android:width="0.5dp"
                android:color="#10ffffff" />
        </shape>
    </item>
    
</layer-list>
