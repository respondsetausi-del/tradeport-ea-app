<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Liquid Glass Card - Frosted, light, translucent -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base frosted glass fill - light gray translucent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
    <!-- Inner lighter highlight for depth -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#30FFFFFF"
                android:endColor="#18FFFFFF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    
    <!-- Subtle top edge highlight -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#25FFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
</layer-list>
