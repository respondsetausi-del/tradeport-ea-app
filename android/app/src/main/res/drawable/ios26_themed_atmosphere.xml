<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Themed Atmosphere - Base gradient, tint applied programmatically -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Dark base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    
    <!-- Center atmosphere glow - will be tinted by ThemeEngine -->
    <item android:id="@+id/atmosphere_glow">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="50%"
                android:centerY="40%"
                android:startColor="#40990000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
    <!-- Bottom ambient -->
    <item android:id="@+id/atmosphere_bottom">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerX="50%"
                android:centerY="100%"
                android:startColor="#25990000"
                android:endColor="#00000000" />
        </shape>
    </item>
    
</layer-list>
