<?xml version="1.0" encoding="utf-8"?>
<!-- Glass inner bar for PAIRS/TRADE/INFO control panels - soft top edge -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Dark base blends with the overlay fade above -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#60000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Glass fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Top edge softener: fades the top into nothing -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#08FFFFFF"
                android:centerColor="#04FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.3" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Border: subtle -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#18FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
</layer-list>
