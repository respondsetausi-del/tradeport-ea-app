<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Drawer Header - Calm, premium, centered -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Glass base -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0A0A0A" />
        </shape>
    </item>
    
    <!-- Subtle internal lighting -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#06FFFFFF"
                android:centerColor="#00000000"
                android:endColor="#04FFFFFF" />
        </shape>
    </item>
    
    <!-- Bottom separator - very subtle -->
    <item
        android:top="-1dp"
        android:left="-1dp"
        android:right="-1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#08FFFFFF" />
        </shape>
    </item>
    
</layer-list>
