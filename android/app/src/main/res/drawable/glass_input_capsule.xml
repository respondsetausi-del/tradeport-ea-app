<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08ffffff" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Glass input surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B3080808" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#25ffffff" />
        </shape>
    </item>
</layer-list>
