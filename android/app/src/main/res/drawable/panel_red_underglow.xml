<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft red halo behind panel -->
    <item
        android:left="-6dp"
        android:top="-6dp"
        android:right="-6dp"
        android:bottom="-6dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A990000" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <!-- Panel surface - matte dark -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a1a1a" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#15990000" />
        </shape>
    </item>
</layer-list>
