<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow - subtle red -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20cc0000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glass button surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6990000"
                android:endColor="#E6770000"
                android:angle="135" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#40ff3333" />
        </shape>
    </item>
</layer-list>
