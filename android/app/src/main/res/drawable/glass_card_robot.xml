<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ambient glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08ffffff" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glass card surface -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#B3080808"
                android:endColor="#B3101010"
                android:angle="135" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#18ffffff" />
        </shape>
    </item>
</layer-list>
