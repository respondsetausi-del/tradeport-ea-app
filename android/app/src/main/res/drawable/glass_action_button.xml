<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#25ffffff" />
        </shape>
    </item>
    <!-- Inner glass button -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <gradient
                android:startColor="#401a1a1a"
                android:endColor="#40101010"
                android:angle="135" />
            <stroke
                android:width="1dp"
                android:color="#35ffffff" />
        </shape>
    </item>
</layer-list>
