<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 26 Glass Dialog - Refined: Lighter, suspended, precise -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Very subtle outer glow -->
    <item
        android:top="-2dp"
        android:left="-2dp"
        android:right="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:centerX="50%"
                android:centerY="50%"
                android:startColor="#18880000"
                android:endColor="#00000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    
    <!-- Glass surface - lighter, more translucent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D8121212" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    
    <!-- Internal lighting - subtle top glow -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    
    <!-- Soft edge catch -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#0CFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    
</layer-list>
