<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass orb for floating icon -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base fill -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
    
    <!-- Top highlight gradient -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:centerY="0.5" />
        </shape>
    </item>
    
    <!-- Border stroke -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
    
</layer-list>
