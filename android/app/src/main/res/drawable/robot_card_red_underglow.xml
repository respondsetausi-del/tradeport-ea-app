<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Very subtle red underglow -->
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="rectangle">
            <solid android:color="#18990000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Card surface - dark and solid -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dark_surface" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#28990000" />
        </shape>
    </item>
</layer-list>
