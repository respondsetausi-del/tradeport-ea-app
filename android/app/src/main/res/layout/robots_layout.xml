<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Glass Card for robot list item - glow applied directly -->
    <FrameLayout
        android:id="@+id/robot_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_solid_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

            <!-- Robot Logo - circular with individual neon glow -->
            <FrameLayout
                android:id="@+id/logo_glow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logo_card"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="#FF222222">

                    <ImageView
                        android:id="@+id/logo_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_baseline_arrow_circle_right_24" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Robot Name -->
            <TextView
                android:id="@+id/bot_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Profit Journey PV1.0"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Arrow indicator -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
                android:rotation="-90"
                app:tint="@color/grey_muted" />

            </LinearLayout>
    </FrameLayout>
</RelativeLayout>