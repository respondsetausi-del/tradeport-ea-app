<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nav_header_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ios26_drawer_header_refined"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="32dp"
    android:paddingBottom="20dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="App Logo" />

    <TextView
        android:id="@+id/nav_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Trade Port EA"
        android:textColor="@color/text_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_header_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tradeport.EA"
        android:textColor="@color/text_meta"
        android:textSize="11sp" />

    <!-- Theme Swatches Label -->
    <TextView
        android:id="@+id/nav_header_accent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Accent"
        android:textColor="@color/text_meta"
        android:textSize="10sp"
        android:letterSpacing="0.1" />

    <!-- Theme Swatches: 9 colors in 2 rows -->
    <LinearLayout
        android:id="@+id/theme_swatches"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Row 1: Crimson, Ocean, Emerald, Violet, Amber -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Crimson -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_crimson_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="visible" />
                <ImageView
                    android:id="@+id/swatch_crimson"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_crimson"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Ocean -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_ocean_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_ocean"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_ocean"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Emerald -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_emerald_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_emerald"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_emerald"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Violet -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_violet_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_violet"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_violet"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Amber -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/swatch_amber_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_amber"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_amber"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

        </LinearLayout>

        <!-- Row 2: Silver, Black, White, Dark Blue -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Silver -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_silver_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_silver"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_silver"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Black -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_black_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_black"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_black"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- White -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="5dp">
                <ImageView
                    android:id="@+id/swatch_white_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_white"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_white"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Dark Blue -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
                <ImageView
                    android:id="@+id/swatch_dark_blue_ring"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/theme_swatch_selected"
                    android:layout_gravity="center"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/swatch_dark_blue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/theme_swatch_dark_blue"
                    android:layout_gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
