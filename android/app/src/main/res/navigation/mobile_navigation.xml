<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.bellyforex.tradeportea.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_navigation_home_to_addRobotFragment"
            app:destination="@id/addRobotFragment" />
        <action
            android:id="@+id/action_navigation_home_to_assetsFragment"
            app:destination="@id/assetsFragment" />

    </fragment>

    <fragment
        android:id="@+id/addRobotFragment"
        android:name="com.bellyforex.tradeportea.ui.home.addrobot.AddRobotFragment"
        android:label="add_robot_fragment"
        tools:layout="@layout/add_robot_fragment" />
    <fragment
        android:id="@+id/assetsFragment"
        android:name="com.bellyforex.tradeportea.ui.home.assets.AssetsFragment"
        android:label="assets_fragment"
        tools:layout="@layout/assets_fragment" >
        <action
            android:id="@+id/action_assetsFragment_to_editAssetFragment"
            app:destination="@id/editAssetFragment" />
    </fragment>
    <fragment
        android:id="@+id/editAssetFragment"
        android:name="com.bellyforex.tradeportea.ui.home.assets.edit.EditAssetFragment"
        android:label="fragment_edit_asset"
        tools:layout="@layout/fragment_edit_asset" />
    <fragment
        android:id="@+id/navigation_metatrader"
        android:name="com.bellyforex.tradeportea.ui.metatrader.MetatraderFragment"
        android:label="fragment_metatrader"
        tools:layout="@layout/fragment_metatrader" />
    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.bellyforex.tradeportea.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
</navigation>